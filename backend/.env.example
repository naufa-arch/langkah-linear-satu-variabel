# Salin menjadi .env (di folder utama proyek ATAU di folder backend/) lalu isi. Jangan commit berkas .env.
ENVIRONMENT=development

# ---------- Tutor AI (kunci HANYA di server, tidak pernah dikirim ke HP) ----------
# DeepSeek dipakai bila terisi (https://platform.deepseek.com > API keys)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Gemini dipakai otomatis bila DEEPSEEK_API_KEY kosong
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# auto | deepseek | gemini
# AI_PROVIDER=auto
# AI_REQUESTS_PER_MINUTE=20

# ---------- Dasbor peneliti ----------
# Kata sandi untuk menu "Dasbor peneliti/guru"
RESEARCHER_PASSWORD=ganti-dengan-kata-sandi
# String acak panjang (minimal 32 karakter) untuk menandatangani sesi login
JWT_SECRET=ganti-dengan-string-acak-panjang

# ---------- Basis data ----------
# Lokal: kosongkan (otomatis SQLite di backend/data/langkah.db)
# Render: WAJIB PostgreSQL gratis (Neon/Supabase), contoh:
# DATABASE_URL=postgresql://user:password@host/dbname

# Domain yang boleh memanggil API (pisahkan dengan koma). Bawaan sudah termasuk aplikasi Android.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://localhost,capacitor://localhost
# FRONTEND_PATH=C:/path/ke/frontend
