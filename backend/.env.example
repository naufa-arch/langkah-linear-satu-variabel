# Salin menjadi .env lalu sesuaikan. Jangan commit berkas .env.
ENVIRONMENT=development
# Domain frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Folder frontend yang disajikan di "/" (default: ../frontend)
# FRONTEND_PATH=C:/path/ke/frontend
# Ditambahkan di Sprint S6:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname
# JWT_SECRET=ganti-dengan-string-acak-panjang
